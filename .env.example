# Copy to .env and adjust. Never commit real values.
# PostgreSQL connection (used by db-init.sh / db-health.sh)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=elastic_web

# Optional: model pricing overrides for the benchmark (USD per token)
# MODEL_INPUT_RATE=0.000002
# MODEL_OUTPUT_RATE=0.000008
