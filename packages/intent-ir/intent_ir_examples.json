{
  "schema": "intent_ir.schema.json",
  "schema_version": "1.0",
  "purpose": "Validation corpus for Intent IR V1. Examples record representation, not parser quality.",
  "examples": [
    {
      "id": "call-mom",
      "kind": "simple",
      "utterance": "Call Mom.",
      "note": "A simple intent stays simple: action + object, nothing else.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "call-mom",
        "revision": 1,
        "source_text": "Call Mom.",
        "action": { "status": "resolved", "value": "call", "surface": "Call" },
        "object": { "status": "resolved", "value": "Mom", "surface": "Mom" }
      }
    },
    {
      "id": "open-whatsapp",
      "kind": "simple",
      "utterance": "Open WhatsApp.",
      "note": "Target is the app. No object is required.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "open-whatsapp",
        "revision": 1,
        "source_text": "Open WhatsApp.",
        "action": { "status": "resolved", "value": "open", "surface": "Open" },
        "target": { "status": "resolved", "value": "WhatsApp", "surface": "WhatsApp" }
      }
    },
    {
      "id": "search-youtube-jazz",
      "kind": "simple",
      "utterance": "Search YouTube for jazz.",
      "note": "One extra slot (query) is enough. No invented domain.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "search-youtube",
        "revision": 1,
        "source_text": "Search YouTube for jazz.",
        "action": { "status": "resolved", "value": "search", "surface": "Search" },
        "target": { "status": "resolved", "value": "YouTube", "surface": "YouTube" },
        "slots": [
          { "name": "query", "status": "resolved", "value": "jazz", "surface": "jazz" }
        ]
      }
    },
    {
      "id": "send-this-to-mom",
      "kind": "deictic",
      "utterance": "Send this to Mom.",
      "note": "Deixis stays unresolved. The schema does not invent what 'this' is.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "send-mom",
        "revision": 1,
        "source_text": "Send this to Mom.",
        "action": { "status": "resolved", "value": "send", "surface": "Send" },
        "object": { "status": "unresolved", "value": null, "surface": "this" },
        "slots": [
          { "name": "recipient", "status": "resolved", "value": "Mom", "surface": "Mom" }
        ]
      }
    },
    {
      "id": "send-mom-sarcastic",
      "kind": "preference",
      "utterance": "Something sarcastic.",
      "prior": "send-mom",
      "note": "Same intent_id. Tone is a preference, not a resolved content slot.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "send-mom",
        "revision": 2,
        "source_text": "Something sarcastic.",
        "action": { "status": "resolved", "value": "send", "surface": "Send" },
        "object": { "status": "unresolved", "value": null, "surface": "this" },
        "slots": [
          { "name": "recipient", "status": "resolved", "value": "Mom", "surface": "Mom" }
        ],
        "preferences": [
          { "path": "tone", "value": "sarcastic", "surface": "Something sarcastic" }
        ]
      }
    },
    {
      "id": "play-the-second-one",
      "kind": "deictic",
      "utterance": "Play the second one.",
      "note": "Object stays unresolved. Ordinal is a slot, not a guessed title.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "play-second",
        "revision": 1,
        "source_text": "Play the second one.",
        "action": { "status": "resolved", "value": "play", "surface": "Play" },
        "object": { "status": "unresolved", "value": null, "surface": "the second one" },
        "slots": [
          { "name": "ordinal", "status": "resolved", "value": 2, "surface": "the second one" }
        ]
      }
    },
    {
      "id": "find-flight-london",
      "kind": "simple",
      "utterance": "Find a flight to London.",
      "note": "Revision 1 of a multi-turn travel intent. Later turns enrich this same id.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "flight-london",
        "revision": 1,
        "source_text": "Find a flight to London.",
        "action": { "status": "resolved", "value": "find", "surface": "Find" },
        "object": { "status": "resolved", "value": "flight", "surface": "a flight" },
        "slots": [
          { "name": "destination", "status": "resolved", "value": "London", "surface": "London" }
        ]
      }
    },
    {
      "id": "flight-nothing-overnight",
      "kind": "exclusion",
      "utterance": "Nothing overnight.",
      "prior": "flight-london",
      "note": "Exclusion is recorded as exclusion. It is not rewritten as a resolved schedule slot.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "flight-london",
        "revision": 2,
        "source_text": "Nothing overnight.",
        "action": { "status": "resolved", "value": "find", "surface": "Find" },
        "object": { "status": "resolved", "value": "flight", "surface": "a flight" },
        "slots": [
          { "name": "destination", "status": "resolved", "value": "London", "surface": "London" }
        ],
        "exclusions": [
          { "path": "schedule", "value": "overnight", "surface": "Nothing overnight" }
        ]
      }
    },
    {
      "id": "flight-prefer-emirates",
      "kind": "preference",
      "utterance": "I'd prefer Emirates.",
      "prior": "flight-nothing-overnight",
      "note": "Preference does not fill an airline slot. Soft want stays soft.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "flight-london",
        "revision": 3,
        "source_text": "I'd prefer Emirates.",
        "action": { "status": "resolved", "value": "find", "surface": "Find" },
        "object": { "status": "resolved", "value": "flight", "surface": "a flight" },
        "slots": [
          { "name": "destination", "status": "resolved", "value": "London", "surface": "London" }
        ],
        "preferences": [
          { "path": "airline", "value": "Emirates", "surface": "I'd prefer Emirates" }
        ],
        "exclusions": [
          { "path": "schedule", "value": "overnight", "surface": "Nothing overnight" }
        ]
      }
    },
    {
      "id": "flight-friday",
      "kind": "revision",
      "utterance": "Actually, make that Friday.",
      "prior": "flight-prefer-emirates",
      "note": "Same intent_id, new revision. when is added. Schema unchanged. Overnight exclusion and Emirates preference survive.",
      "intent": {
        "schema_version": "1.0",
        "intent_id": "flight-london",
        "revision": 4,
        "source_text": "Actually, make that Friday.",
        "action": { "status": "resolved", "value": "find", "surface": "Find" },
        "object": { "status": "resolved", "value": "flight", "surface": "a flight" },
        "slots": [
          { "name": "destination", "status": "resolved", "value": "London", "surface": "London" },
          { "name": "when", "status": "resolved", "value": "Friday", "surface": "Friday" }
        ],
        "preferences": [
          { "path": "airline", "value": "Emirates", "surface": "I'd prefer Emirates" }
        ],
        "exclusions": [
          { "path": "schedule", "value": "overnight", "surface": "Nothing overnight" }
        ]
      }
    },
    {
      "id": "dinner-tonight",
      "kind": "deictic",
      "utterance": "Find somewhere for dinner tonight.",
      "note": "'somewhere' stays unresolved. when and occasion are known.",
