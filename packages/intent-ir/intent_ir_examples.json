          { "name": "occasion", "status": "resolved", "value": "dinner", "surface": "dinner" },
          { "name": "when", "status": "resolved", "value": "tonight", "surface": "tonight" }
        ]
      }
    },
    {
      "id": "dinner-vegetarian",
